pkgname=corolla
pkgver=0.1.0
pkgrel=1
pkgdesc='Interactive radial disk explorer for Omarchy'
arch=('x86_64' 'aarch64')
depends=('glib2' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'libxcb' 'xdg-desktop-portal')
makedepends=('cargo')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --locked --release
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "${CARGO_TARGET_DIR:-target}/release/corolla" "$pkgdir/usr/bin/corolla"
    install -Dm644 packaging/corolla.desktop "$pkgdir/usr/share/applications/corolla.desktop"
    install -Dm644 packaging/corolla.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/corolla.svg"
    install -Dm644 assets/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/corolla/Inter-OFL.txt"
}
